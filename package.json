{
  "name": "study-cards-vercel",
  "version": "1.39.0",
  "description": "Private, single-owner study cards hosted on Vercel with OpenRouter",
  "scripts": {
    "test": "node scripts/test-environment.mjs -- vitest",
    "dev": "vite dev",
    "build": "vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:run": "node scripts/test-environment.mjs -- vitest run",
    "test:ui": "node scripts/test-environment.mjs --database -- playwright test",
    "start": "node build/server/index.mjs",
    "test:server": "node scripts/test-environment.mjs -- vitest run server",
    "ui:foundation": "vite --config tests/foundation/vite.config.mjs",
    "foundation:dev": "vite --config tests/shared-ui/vite.config.mjs",
    "foundation:build": "vite build --config tests/shared-ui/vite.config.mjs",
    "foundation:preview": "vite preview --config tests/shared-ui/vite.config.mjs",
    "test:foundation": "node scripts/test-environment.mjs -- playwright test --config playwright.foundation.config.mjs",
    "build:test": "node scripts/test-environment.mjs -- npm run build",
    "build:vercel:test": "node scripts/test-environment.mjs -- npm run build:vercel",
    "test:pwa": "node scripts/test-environment.mjs --database --serve -- node tests/pwa-offline.mjs",
    "test:foundation:webkit": "node scripts/test-environment.mjs -- playwright test --config playwright.foundation-webkit.config.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
