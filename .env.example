# Node.js 24; one owner per deployment. Never use VITE_ variables for secrets.
# At least 32 random characters; changing it invalidates sessions and saved key encryption.
APP_SECRET=
# A distinct password for this deployment.
APP_PASSWORD=
# Pooled Neon PostgreSQL URL with the provider's SSL settings.
DATABASE_URL=
# Connected PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional startup key; saving or removing a key in Settings takes precedence.
OPENROUTER_API_KEY=
# Initial defaults; the owner's saved selection takes precedence.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_REASONING_EFFORT=xhigh
